# Root-level values become environment variables in Streamlit. No credentials.
MADRID_REHAB_PUBLIC = "1"
MADRID_REHAB_OFFLINE = "1"
MADRID_REHAB_DEV = "0"
MADRID_REHAB_DEMO = "0"
MADRID_REHAB_PILOT = "0"

# Session 29: choose one delivery method after approving the data upload.
# Local mounted/copied immutable package (relative to repository root):
# MADRID_REHAB_BUNDLE_DIR = "data/deployment/madrid_rehab_v1_02"
# Or pinned HTTPS archive; bootstrap materializes it once without credentials:
# MADRID_REHAB_BUNDLE_URL = "https://YOUR-READ-ONLY-HOST/madrid_rehab_v1_02.tar.gz"
# MADRID_REHAB_BUNDLE_SHA256 = "COPY_SHA256_FROM_DELIVERY_JSON"
# MADRID_REHAB_BUNDLE_DIR = "data/deployment/cloud_v1_02"
